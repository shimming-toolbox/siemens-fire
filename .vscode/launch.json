            "console": "integratedTerminal",
            "python": "/root/shimming-toolbox/python/bin/python",
            "env":{
                "PYTHONPATH": "/root/.local/lib/python3.13/site-packages"
            },
            "consoleTitle": "Server",
            "justMyCode": true,
        },

