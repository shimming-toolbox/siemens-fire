    "version": "0.2.0",
    "configurations": [
        // Start server
        {
            "name": "Start server",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/code/python-ismrmrd-server/main.py",
            "args": [
                "-H", "0.0.0.0",
                "-p", "9020",
                "-l", "/tmp/share/log/server.log",
